ADMIN_PASSWORD=verba-admin
ADMIN_SECRET=verba-local-demo-secret
# Без токена `npm run bot` завершится с кодом 1 и не будет отвечать на /start.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — ссылка на лендинге.
TELEGRAM_BOT_USERNAME=
# Id группы (часто отрицательный). Если пусто, заявка всё равно пишется в SQLite, в лог — предупреждение.
TELEGRAM_GROUP_CHAT_ID=
# Публичный HTTPS Mini App, страница календаря. Пример: https://xxxx.ngrok-free.app/tg
# Пусто — бот пишет, что ссылки нет, и оставляет запись в чате. http:// не подходит.
WEBAPP_URL=
